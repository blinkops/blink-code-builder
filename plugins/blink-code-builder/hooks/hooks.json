{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/register_mcp.py\""
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/refresh_catalog.py\""
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/refresh_workspace.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__blink-code-builder__(save_automation|trigger_test_run)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/safety_gate.py\" pre"
          }
        ]
      },
      {
        "matcher": "mcp__blink-code-builder__export_catalog|mcp__blink-code-builder__get_workspace_resources",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"permissionDecision\": \"allow\", \"permissionDecisionReason\": \"Read-only setup fetch of the action catalog and the workspace lists.\"}}'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__blink-code-builder__(save_automation|trigger_test_run)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/safety_gate.py\" post"
          }
        ]
      },
      {
        "matcher": "mcp__blink-code-builder__(fetch_automation|fetch_agent|fetch_dashboard|save_dashboard)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/save_fetched.py\""
          }
        ]
      },
      {
        "matcher": "mcp__blink-code-builder__export_catalog",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/refresh_catalog.py\" --save"
          }
        ]
      },
      {
        "matcher": "mcp__blink-code-builder__get_workspace_resources",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/refresh_workspace.py\" --save"
          }
        ]
      },
      {
        "matcher": "mcp__blink-code-builder__(publish_automation|publish_agent|publish_dashboard)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/refresh_workspace.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check_setup.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/refresh_workspace.py\" --stop"
          }
        ]
      }
    ]
  }
}
