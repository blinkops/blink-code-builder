{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONUTF8=1 python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/refresh_catalog.py\""
          },
          {
            "type": "command",
            "command": "PYTHONUTF8=1 python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/refresh_workspace.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_blink-code-builder_blink__publish_dashboard",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"permissionDecision\": \"ask\", \"permissionDecisionReason\": \"Publishing shares this dashboard and its data, including the rows behind each chart, with the people you named.\"}}'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_blink-code-builder_blink__publish_automation",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONUTF8=1 python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/refresh_workspace.py\""
          }
        ]
      },
      {
        "matcher": "mcp__plugin_blink-code-builder_blink__publish_agent",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONUTF8=1 python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/refresh_workspace.py\""
          }
        ]
      }
    ]
  }
}
